# VidSetu Environment Configuration
#
# VidSetu is a pure-frontend streaming platform: movie/TV metadata comes from TMDB (and TVmaze
# as a supplementary TV source), user accounts and Watch Spaces are stored in Supabase.

# --- TMDB (The Movie Database) ---
# Get a Read Access Token from: https://www.themoviedb.org/settings/api
# This is TMDB's own client-side token model (same trust model as a public API key) - it is safe
# to ship in the browser bundle, same as the old VITE_GOOGLE_API_KEY was.
VITE_TMDB_API_KEY=

# --- Supabase (Auth + Database) ---
# Create a project at https://supabase.com, then Project Settings > API for these two values.
# Enable the Google provider under Authentication > Providers, reusing the Google OAuth Client
# ID/Secret you already created for this app.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Provider configuration ---
# Centralizes which metadata/playback provider implementation is active. See
# src/services/content/config.ts. Comma-separated for playback = ordered fallback chain.
VITE_CONTENT_PROVIDER=tmdb
VITE_PLAYBACK_PROVIDERS=stream,archive,trailer
